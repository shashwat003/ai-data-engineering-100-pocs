# Data product manifest. The contract and SLOs below are the agreement with consumers.
product: {{ name }}
domain: {{ domain }}
owner:
  team: {{ owner_team }}
  oncall: {{ oncall }}
tier: silver
status: draft
inputs: [raw_{{ name }}]
output:
  table: {{ name }}
contract: contract.yaml
slos:
  freshness_hours: 26
  completeness_min: 0.99
  validity_min: 0.98
  volume_tolerance_pct: 40
  availability_target: 0.95
  window_days: 30
access:
  classification: internal
  allowed_roles: [analyst, data_scientist, service_account]
retention_days: 730
consumers: []
